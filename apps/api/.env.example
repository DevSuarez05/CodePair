# ============================================================
#  CodePair API - Environment Variables
#  Copy this file to .env and fill in the values
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database (MySQL) ─────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://codepair_user:your_password_here@localhost:3306/codepair_db"

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_ACQUIRE_TIMEOUT=60000

# ── Authentication ───────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Settings
COOKIE_SECRET=your_cookie_secret_here_min_32_chars
COOKIE_SECURE=false       # true in production (HTTPS only)
COOKIE_SAME_SITE=lax      # strict | lax | none

# ── Argon2 Hashing ──────────────────────────────────────────
ARGON2_MEMORY_COST=65536  # 64 MB
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Rate Limiting ────────────────────────────────────────────
THROTTLE_TTL=60000        # 1 minute in milliseconds
THROTTLE_LIMIT=100        # requests per TTL window

# ── Socket.IO ────────────────────────────────────────────────
SOCKET_CORS_ORIGINS=http://localhost:3000
SOCKET_TRANSPORTS=websocket,polling

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug           # error | warn | info | debug | verbose
LOG_FORMAT=pretty         # pretty | json

# ── Frontend URL (for email links, CORS, etc.) ───────────────
FRONTEND_URL=http://localhost:3000
